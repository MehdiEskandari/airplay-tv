diff --git a/lib/pairing.c b/lib/pairing.c
--- a/lib/pairing.c
+++ b/lib/pairing.c
@@ -656,0 +657,10 @@
+
+/* Tizen adapter: expose only an identity whose signature was verified. */
+char *pairing_session_get_verified_key(pairing_session_t *session) {
+    if (!session || session->status != STATUS_FINISHED || !session->ed_theirs) return NULL;
+    unsigned char key[ED25519_KEY_SIZE];
+    char *base64 = NULL;
+    ed25519_key_get_raw(key, session->ed_theirs);
+    ed25519_pk_to_base64(key, &base64);
+    return base64;
+}
